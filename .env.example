# Copia este archivo a .env y rellena los valores. .env NO se sube al repo.

# ── OBLIGATORIA para el modo agente ────────────────────────────────────────
# Una sola clave cubre dos usos: el LLM que razona y los embeddings de la base
# vectorial. Sin ella el sistema sigue funcionando en modo determinístico
# (BM25 + cálculo en Python), pero sin razonamiento ni búsqueda semántica.
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OPCIONALES: ajuste de modelos ──────────────────────────────────────────
MODELO_LLM=gpt-4o-mini
MODELO_EMBEDDINGS=text-embedding-3-small
TEMPERATURA_LLM=0.0

# ── OPCIONALES: trazabilidad con LangSmith ─────────────────────────────────
# Traza cada paso del grafo y cada llamada a herramienta, visible en
# https://smith.langchain.com. Obtener la clave en Settings > API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pfannenberg-copilot
