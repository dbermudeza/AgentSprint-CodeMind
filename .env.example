# Copia este archivo a .env y rellena los valores. .env NO se sube al repo.
#
# El proyecto está configurado para funcionar SIN COSTE:
#   - LLM: Groq (tier gratuito, sin tarjeta)
#   - Embeddings: modelo local, sin API key

# ── ÚNICA CLAVE NECESARIA ──────────────────────────────────────────────────
# Gratuita, sin tarjeta de crédito: https://console.groq.com/keys
GROQ_API_KEY=

# ── OPCIONALES: ajuste del LLM ─────────────────────────────────────────────
# PROVEEDOR_LLM=groq                      # "groq" (gratis) | "openai" (requiere crédito)
# MODELO_GROQ=llama-3.3-70b-versatile     # debe soportar tool calling
# TEMPERATURA_LLM=0.0

# ── OPCIONALES: embeddings ─────────────────────────────────────────────────
# "local" no necesita clave y es el valor por defecto. Cambiar a "openai" exige
# crédito y obliga a reconstruir el índice: la dimensión del vector cambia
# (384 -> 1536) y no se pueden mezclar.
# MODO_EMBEDDINGS=local
# OPENAI_API_KEY=

# ── OPCIONALES: trazabilidad con LangSmith ─────────────────────────────────
# Traza cada paso del razonamiento y cada llamada a herramienta, visible en
# https://smith.langchain.com. Clave en Settings > API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pfannenberg-copilot
